<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Tarjeta virtual: saldo, estado, recarga y movimientos -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cinemauq.controller.TarjetaController"
      spacing="14">
    <VBox spacing="4">
        <Label text="Mi tarjeta virtual" styleClass="titulo-vista"/>
        <Label text="Consulta tu saldo, recarga la tarjeta y revisa todos sus movimientos." styleClass="subtitulo"/>
    </VBox>

    <HBox spacing="16">
        <VBox spacing="8" styleClass="tarjeta-virtual" prefWidth="340" minWidth="320">
            <Label text="TARJETA VIRTUAL CINEMAUQ"/>
            <Label fx:id="lblNumero" styleClass="tarjeta-virtual-numero"/>
            <Region prefHeight="10"/>
            <Label text="Saldo disponible"/>
            <Label fx:id="lblSaldo" styleClass="tarjeta-virtual-saldo"/>
            <Label fx:id="lblTitular"/>
        </VBox>

        <VBox spacing="10" styleClass="tarjeta" prefWidth="250" minWidth="230">
            <Label text="Estado" styleClass="titulo-seccion"/>
            <HBox>
                <Label fx:id="lblEstado"/>
            </HBox>
            <Label text="Con la tarjeta inactiva no se pueden hacer compras ni recargas."
                   wrapText="true" styleClass="texto-secundario" minHeight="-Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="btnEstado" onAction="#cambiarEstado"
                    styleClass="boton-secundario" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="10" styleClass="tarjeta" HBox.hgrow="ALWAYS" minWidth="300">
            <Label text="Recargar saldo" styleClass="titulo-seccion"/>
            <Label text="Las recargas las autoriza el administrador del cine."
                   wrapText="true" styleClass="texto-secundario" minHeight="-Infinity"/>
            <HBox spacing="8">
                <Button text="+ $20.000" onAction="#sugerir20" styleClass="boton-secundario"/>
                <Button text="+ $50.000" onAction="#sugerir50" styleClass="boton-secundario"/>
                <Button text="+ $100.000" onAction="#sugerir100" styleClass="boton-secundario"/>
            </HBox>
            <HBox spacing="8">
                <TextField fx:id="txtMonto" promptText="Monto a recargar" HBox.hgrow="ALWAYS"/>
                <Button text="Recargar" onAction="#recargar" styleClass="boton-primario"/>
            </HBox>
        </VBox>
    </HBox>

    <VBox spacing="8" styleClass="tarjeta" VBox.vgrow="ALWAYS">
        <Label text="Movimientos" styleClass="titulo-seccion"/>
        <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="140"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="330"/>
                <TableColumn fx:id="colMonto" text="Monto" prefWidth="130"/>
                <TableColumn fx:id="colSaldo" text="Saldo final" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
