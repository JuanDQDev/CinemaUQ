<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:id="paginaAsientos" fx:controller="com.example.cinemauq.controller.AsientosController" spacing="20">
    <VBox spacing="6">
        <Label text="EL MEJOR LUGAR PARA VIVIRLA" styleClass="eyebrow"/>
        <Label fx:id="lblPelicula" styleClass="titulo-vista"/>
        <Label fx:id="lblFuncion" styleClass="subtitulo" wrapText="true"/>
    </VBox>
    <HBox spacing="24" alignment="TOP_LEFT">
        <VBox spacing="14" alignment="TOP_CENTER" styleClass="tarjeta,sala-cine" HBox.hgrow="ALWAYS" minWidth="0">
            <StackPane fx:id="fondoPantalla" prefHeight="180" minHeight="180" maxHeight="180" maxWidth="Infinity"/>
            <Region styleClass="pantalla" maxWidth="500" prefWidth="500"/>
            <Label text="PANTALLA" styleClass="texto-pantalla"/>
            <ScrollPane fitToWidth="true" styleClass="scroll-limpio" prefHeight="280" minHeight="280"
                        hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                <GridPane fx:id="gridAsientos" hgap="8" vgap="8" alignment="CENTER"/>
            </ScrollPane>
            <HBox spacing="22" alignment="CENTER">
                <HBox spacing="7" alignment="CENTER_LEFT">
                    <Region styleClass="muestra-libre"/>
                    <Label text="Libre" styleClass="texto-secundario"/>
                </HBox>
                <HBox spacing="7" alignment="CENTER_LEFT">
                    <Region styleClass="muestra-seleccionado"/>
                    <Label text="Tu selección" styleClass="texto-secundario"/>
                </HBox>
                <HBox spacing="7" alignment="CENTER_LEFT">
                    <Region styleClass="muestra-ocupado"/>
                    <Label text="Ocupado" styleClass="texto-secundario"/>
                </HBox>
            </HBox>
        </VBox>
        <VBox spacing="16" prefWidth="300" minWidth="280" maxWidth="300" styleClass="tarjeta">
            <Label text="TU EXPERIENCIA" styleClass="eyebrow"/>
            <Label text="Elige tu lugar" styleClass="titulo-detalle"/>
            <Label fx:id="lblAsientos" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblTipoEntrada" wrapText="true" styleClass="texto-secundario" minHeight="-Infinity"/>
            <Separator/>
            <Label text="Subtotal de entradas" styleClass="texto-secundario"/>
            <Label fx:id="lblSubtotal" styleClass="valor-grande"/>
            <Button fx:id="btnContinuar" text="Continuar a confitería  →" onAction="#continuar"
                    styleClass="boton-primario" maxWidth="Infinity"/>
            <Button text="←  Volver a la cartelera" onAction="#volver"
                    styleClass="boton-secundario" maxWidth="Infinity"/>
            <Label text="Selecciona los asientos con un clic. Los ocupados no se pueden elegir."
                   styleClass="texto-secundario" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
</VBox>

