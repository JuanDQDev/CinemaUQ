<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Historial de compras del cliente -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cinemauq.controller.ComprasController"
      spacing="14">
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label text="Mis compras" styleClass="titulo-vista"/>
            <Label fx:id="lblResumen" styleClass="subtitulo"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Comprar más entradas" onAction="#irACartelera" styleClass="boton-primario"/>
    </HBox>
    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS" prefHeight="360" minHeight="300">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colFactura" text="Factura" prefWidth="110"/>
                <TableColumn fx:id="colFecha" text="Fecha de compra" prefWidth="130"/>
                <TableColumn fx:id="colPelicula" text="Película" prefWidth="170"/>
                <TableColumn fx:id="colFuncion" text="Función" prefWidth="260"/>
                <TableColumn fx:id="colAsientos" text="Asientos" prefWidth="110"/>
                <TableColumn fx:id="colConfiteria" text="Confitería" prefWidth="160"/>
                <TableColumn fx:id="colTotal" text="Pagado" prefWidth="100"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                <TableColumn fx:id="colReembolso" text="Devuelto" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
    <VBox spacing="12" styleClass="tarjeta">
        <Label text="Cancelación y reembolso" styleClass="titulo-seccion"/>
        <Label text="Más de 24 horas: 100 %. Entre 2 y 24 horas: 80 %. Con menos de 2 horas no se permite cancelar." wrapText="true" styleClass="texto-secundario"/>
        <Label fx:id="lblCancelacion" wrapText="true"/>
        <Button fx:id="btnCancelar" text="Cancelar compra" onAction="#cancelarCompra" styleClass="boton-primario" disable="true"/>
    </VBox>
</VBox>
