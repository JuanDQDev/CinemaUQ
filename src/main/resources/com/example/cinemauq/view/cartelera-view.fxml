<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cinemauq.controller.CarteleraController" spacing="22">
    <VBox spacing="7">
        <Label text="AHORA EN CINEMAUQ" styleClass="eyebrow"/>
        <Label text="Tu próxima historia empieza aquí." styleClass="titulo-vista"/>
        <Label text="Explora la cartelera, encuentra tu función y reserva tu lugar." styleClass="subtitulo"/>
    </VBox>
    <HBox spacing="24" alignment="TOP_LEFT">
        <VBox spacing="10" HBox.hgrow="ALWAYS" minWidth="0">
            <FlowPane fx:id="panelPeliculas" hgap="16" vgap="24" prefWrapLength="800" styleClass="panel-peliculas"/>
            <Label text="Un clic para explorar · Doble clic para elegir asientos"
                   styleClass="texto-secundario" wrapText="true"/>
        </VBox>
        <VBox fx:id="panelDetalle" spacing="12" prefWidth="320" minWidth="300" maxWidth="320"
              styleClass="tarjeta,detalle-pelicula">
            <Label text="TU FUNCIÓN" styleClass="eyebrow"/>
            <Label fx:id="lblTitulo" styleClass="titulo-detalle" wrapText="true" minHeight="-Infinity"/>
            <HBox><Label fx:id="lblClasificacion" styleClass="etiqueta-clasificacion"/></HBox>
            <Label fx:id="lblDescripcion" wrapText="true" styleClass="texto-secundario" minHeight="-Infinity"/>
            <Separator/>
            <Label text="Elige el horario" styleClass="titulo-seccion"/>
            <ListView fx:id="listaFunciones" styleClass="lista-funciones" prefHeight="170" minHeight="150"/>
            <Label fx:id="lblPrecio" wrapText="true" styleClass="texto-precio" minHeight="-Infinity"/>
            <Button fx:id="btnElegirAsientos" text="Elegir asientos  →" onAction="#elegirAsientos"
                    styleClass="boton-primario" maxWidth="Infinity"/>
        </VBox>
    </HBox>
</VBox>
